Bootstrap: localimage
From: openroad_pre.sif

%environment
    export OPENROAD_EXE=/usr/bin/openroad
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%files
    build/bin/openroad /usr/bin/openroad

%runscript
    #!/bin/bash
    exec openroad "$@"

%labels
    Author OpenROAD Project
    Description OpenROAD
