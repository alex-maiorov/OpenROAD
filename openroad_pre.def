Bootstrap: docker
From: ubuntu:24.04

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export CUDA_HOME=/usr/local/cuda
    export ROCM_PATH=/opt/rocm
    export PATH=/usr/local/cuda/bin:/opt/rocm/bin:/usr/local/bin:${PATH}
    export LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/local/cuda/lib64:/opt/rocm/lib:/usr/local/lib:${LD_LIBRARY_PATH}

%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/Los_Angeles
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

    /opt/DependencyInstaller.sh -ci -base
    /opt/DependencyInstaller.sh -ci -common

    strip --remove-section=.note.ABI-tag /usr/lib/x86_64-linux-gnu/libQt5Core.so || true
    rm -rf /var/lib/apt/lists/*
    rm -f /opt/DependencyInstaller.sh

%files
    etc/DependencyInstaller.sh /opt/DependencyInstaller.sh

%labels
    Author OpenROAD Project
    Description OpenROAD build prerequisites
